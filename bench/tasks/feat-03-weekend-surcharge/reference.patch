@@ -1,7 +1,7 @@
 """Rental pricing: billable days, tier and coupon discounts, coupons, money rounding."""
 
 from dataclasses import dataclass
-from datetime import date
+from datetime import date, timedelta
 from decimal import ROUND_HALF_UP, Decimal
 
 from app.errors import ConflictError, NotFoundError
@@ -40,6 +40,25 @@ def billable_days(days: int) -> int:
     return days - free_days(days)
 
 
+def weekend_surcharge_days(start: date, end: date) -> int:
+    """Saturdays and Sundays in ``[start, end)`` that are not free days.
+
+    The free days are the 7th, 14th, 21st, ... day of the rental (``start`` is day 1).
+    """
+    count = 0
+    for index in range(rental_days(start, end)):
+        day = start + timedelta(days=index)
+        is_free = (index + 1) % FREE_DAY_EVERY == 0
+        if day.weekday() >= 5 and not is_free:
+            count += 1
+    return count
+
+
+def weekend_rate(daily_rate: Decimal, percent: int) -> Decimal:
+    """Surcharge for one weekend day (not rounded)."""
+    return daily_rate * Decimal(percent) / 100
+

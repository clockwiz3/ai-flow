+def revenue_report_csv(report: RevenueReport) -> str:
+    """Render a revenue report as CSV with a trailing ``TOTAL`` row."""
+    buffer = io.StringIO()
+    writer = csv.writer(buffer, lineterminator="\n")
+    writer.writerow(["category", "reservations", "revenue"])
+    for row in report.rows:
+        writer.writerow([row.category, row.reservations, f"{row.revenue:.2f}"])
+    total_count = sum(row.reservations for row in report.rows)
+    writer.writerow(["TOTAL", total_count, f"{report.total:.2f}"])
+    return buffer.getvalue()
+

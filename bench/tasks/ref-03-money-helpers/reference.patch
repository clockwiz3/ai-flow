--- /dev/null
+++ b/app/money.py
@@ -0,0 +1,26 @@
+"""Money and percentage arithmetic.
+
+All rounding in the application happens here, always ``ROUND_HALF_UP``, and only when a
+figure is produced - never on intermediate rates.
+"""
+
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+ZERO = Decimal("0")
+PERCENT_STEP = Decimal("0.1")
+
+
+def to_money(value: Decimal | int | str) -> Decimal:
+    """Round a monetary amount to cents, half up (``Decimal("2.675")`` -> ``2.68``)."""
+    return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)
+
+
+def apply_percent(amount: Decimal, rate: Decimal) -> Decimal:
+    """``amount * rate`` rounded to cents; ``rate`` is a fraction (``0.15`` means 15%)."""
+    return to_money(amount * rate)
+
+
+def to_percent(part: Decimal | int, whole: Decimal | int) -> Decimal:
+    """``part`` as a percentage of ``whole``, rounded half up to one decimal place."""
+    return (Decimal(part) * 100 / Decimal(whole)).quantize(PERCENT_STEP, rounding=ROUND_HALF_UP)

+def booking_discount_rate(store: Store, booking_id: int) -> Decimal:
+    """Combined discount rate of a booking: tier + coupon + bundle, capped.
+
+    The bundle discount applies while the booking has at least ``BUNDLE_MIN_ITEMS``
+    reservations that are not cancelled.
+    """
+    booking = store.bookings.get(booking_id)
+    assert booking is not None
+    customer = get_customer(store, booking.customer_id)
+    coupon = lookup_coupon(store, booking.coupon_code) if booking.coupon_code else None
+    rate = resolve_discounts(customer.tier, coupon).total_rate
+    billed = [
+        rid
+        for rid in booking.reservation_ids
+        if (r := store.reservations.get(rid)) is not None
+        and r.status is not ReservationStatus.CANCELLED
+    ]
+    if len(billed) >= BUNDLE_MIN_ITEMS:
+        rate += BUNDLE_DISCOUNT
+    return min(rate, MAX_TOTAL_DISCOUNT)
+
+
+def reservation_lines(store: Store, reservation: Reservation) -> tuple[list[InvoiceLine], Decimal]:
+    """Invoice lines of one reservation and its (undiscounted) rental amount."""
     item = get_item(store, reservation.item_id)

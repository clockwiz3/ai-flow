diff --git a/app/services/bookings.py b/app/services/bookings.py
new file mode 100644
index 0000000..1b83d51
--- /dev/null
+++ b/app/services/bookings.py
@@ -0,0 +1,154 @@
+"""Bookings: several items reserved together, in one all-or-nothing request."""
+
+from app.clock import Clock
+from app.errors import ConflictError, InvalidRequestError, NotFoundError
+from app.models import (
+    Booking,
+    BookingCreate,
+    BookingInvoice,
+    InvoiceLine,
+    Reservation,
+    ReservationStatus,
+)
+from app.services.availability import find_conflicts, unavailable_reason, validate_range
+from app.services.catalog import get_item
+from app.services.customers import get_customer
+from app.services.invoices import booking_discount_rate, reservation_lines
+from app.services.pricing import TAX_RATE, ZERO, lookup_coupon, money
+from app.services.reservations import MAX_RENTAL_DAYS
+from app.storage import Store
+
+
+class ItemsUnavailableError(ConflictError):
+    """Some items of a booking cannot be reserved for the requested range."""
+
+    def __init__(self, item_ids: list[int]) -> None:
+        ids = ", ".join(str(i) for i in item_ids)
+        super().__init__(f"Items not available for this period: {ids}")
+        self.extra = {"unavailable_item_ids": item_ids}
+
+
+def _reservations(store: Store, booking: Booking) -> list[Reservation]:
+    return [store.reservations.get(rid) for rid in booking.reservation_ids]  # type: ignore[misc]
+
+
+def _with_status(store: Store, booking: Booking) -> Booking:
+    statuses = {r.status for r in _reservations(store, booking)}
+    if ReservationStatus.ACTIVE in statuses:
+        status = ReservationStatus.ACTIVE
+    elif ReservationStatus.RETURNED in statuses:
+        status = ReservationStatus.RETURNED
+    else:
+        status = ReservationStatus.CANCELLED
+    return booking.model_copy(update={"status": status})
+
+
+def get_booking(store: Store, booking_id: int) -> Booking:
+    booking = store.bookings.get(booking_id)
+    if booking is None:
+        raise NotFoundError(f"Booking {booking_id} not found")
+    return _with_status(store, booking)
+
+
+def create_booking(store: Store, clock: Clock, data: BookingCreate) -> Booking:
+    """Reserve every item in ``data.items`` for the same range, or none of them."""
+    if not data.items:
+        raise InvalidRequestError("A booking needs at least one item")
+    if len(set(data.items)) != len(data.items):
+        raise InvalidRequestError("A booking cannot contain the same item twice")
+    validate_range(data.start, data.end)
+    today = clock.today()
+    if data.start < today:
+        raise InvalidRequestError("Reservations cannot start in the past")
+    if (data.end - data.start).days > MAX_RENTAL_DAYS:
+        raise InvalidRequestError(f"Reservations are limited to {MAX_RENTAL_DAYS} days")
+
+    customer = get_customer(store, data.customer_id)
+    coupon_code: str | None = None
+    if data.coupon_code:
+        coupon = lookup_coupon(store, data.coupon_code)
+        if coupon is None:
+            raise InvalidRequestError(f"Unknown coupon code {data.coupon_code!r}")
+        coupon_code = coupon.code
+
+    items = [get_item(store, item_id) for item_id in data.items]
+    unavailable = sorted(
+        item.id
+        for item in items
+        if unavailable_reason(item) is not None
+        or find_conflicts(store, item.id, data.start, data.end)
+    )
+    if unavailable:
+        raise ItemsUnavailableError(unavailable)
+
+    booking_id = store.bookings.allocate_id()
+    reservation_ids: list[int] = []
+    for item in items:
+        reservation = Reservation(
+            id=store.reservations.allocate_id(),
+            item_id=item.id,
+            customer_id=customer.id,
+            start=data.start,
+            end=data.end,
+            coupon_code=coupon_code,
+            booking_id=booking_id,
+            created_on=today,
+        )
+        store.reservations.insert(reservation)
+        reservation_ids.append(reservation.id)
+
+    booking = Booking(
+        id=booking_id,
+        customer_id=customer.id,
+        start=data.start,
+        end=data.end,
+        coupon_code=coupon_code,
+        reservation_ids=reservation_ids,
+    )
+    store.bookings.insert(booking)
+    return _with_status(store, booking)
+
+
+def cancel_booking(store: Store, booking_id: int) -> Booking:
+    """Cancel every active reservation of the booking."""
+    booking = get_booking(store, booking_id)
+    active = [r for r in _reservations(store, booking) if r.status is ReservationStatus.ACTIVE]
+    if not active:
+        raise ConflictError(f"Booking {booking_id} has no active reservations to cancel")
+    for reservation in active:
+        store.reservations.save(
+            reservation.model_copy(update={"status": ReservationStatus.CANCELLED})
+        )
+    return _with_status(store, booking)
+
+
+def get_booking_invoice(store: Store, booking_id: int) -> BookingInvoice:
+    """One invoice for all non-cancelled reservations of the booking."""
+    booking = get_booking(store, booking_id)
+    billed = [
+        r for r in _reservations(store, booking) if r.status is not ReservationStatus.CANCELLED
+    ]
+    if not billed:
+        raise ConflictError(f"Booking {booking_id} is cancelled and has no invoice")
+
+    lines: list[InvoiceLine] = []
+    rental_total = ZERO
+    for reservation in billed:
+        reservation_lines_, rental_amount = reservation_lines(store, reservation)
+        lines.extend(reservation_lines_)
+        rental_total += rental_amount
+
+    rate = booking_discount_rate(store, booking.id)
+    subtotal = sum((line.amount for line in lines), ZERO)
+    discount = money(rental_total * rate)
+    taxable = subtotal - discount
+    tax = money(taxable * TAX_RATE)
+    return BookingInvoice(
+        booking_id=booking.id,
+        customer_id=booking.customer_id,
+        lines=lines,
+        subtotal=money(subtotal),
+        discount=discount,
+        tax=tax,
+        total=money(taxable + tax),
+    )

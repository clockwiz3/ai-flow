+    quote = quote_rental(item, customer, reservation.start, reservation.end)
 
     free_note = f", {quote.free_days} free" if quote.free_days else ""
     lines = [
@@ -51,10 +82,24 @@ def compute_invoice(store: Store, reservation: Reservation) -> Invoice:
     late_line = _late_fee_line(reservation, item.daily_rate)
     if late_line is not None:
         lines.append(late_line)
+    return lines, quote.rental_amount
+
+
+def compute_invoice(store: Store, reservation: Reservation) -> Invoice:
+    """Build the invoice for ``reservation`` regardless of its status."""
+    customer = get_customer(store, reservation.customer_id)
+    lines, rental_amount = reservation_lines(store, reservation)
+    if reservation.booking_id is not None:
+        rate = booking_discount_rate(store, reservation.booking_id)
+    else:
+        coupon = (
+            lookup_coupon(store, reservation.coupon_code) if reservation.coupon_code else None
+        )
+        rate = resolve_discounts(customer.tier, coupon).total_rate
 
     subtotal = sum((line.amount for line in lines), ZERO)
 
-    discount = money(quote.rental_amount * quote.discounts.total_rate)
+    discount = money(rental_amount * rate)
     taxable = subtotal - discount
     tax = money(taxable * TAX_RATE)
 

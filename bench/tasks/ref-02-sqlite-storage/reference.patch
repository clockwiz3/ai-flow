+    """All repositories of one running application instance, sharing one SQLite database.
+
+    ``db_path`` is passed to ``sqlite3.connect``; the default ``":memory:"`` gives every store
+    its own private, empty database. A file path keeps the data between stores.
+    """
+
+    def __init__(self, db_path: str = ":memory:") -> None:
+        self.db_path = db_path
+        self.connection = sqlite3.connect(db_path, check_same_thread=False, isolation_level=None)
+        self.connection.row_factory = sqlite3.Row
+        self._lock = threading.RLock()
+        with self._lock:
+            self.connection.executescript(SCHEMA)
+        self.categories = CategoryRepository(self.connection, self._lock)
+        self.items = ItemRepository(self.connection, self._lock)
+        self.customers = CustomerRepository(self.connection, self._lock)
+        self.reservations = ReservationRepository(self.connection, self._lock)
+        self.coupons = CouponRepository(self.connection, self._lock)
 

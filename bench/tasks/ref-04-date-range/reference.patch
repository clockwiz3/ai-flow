diff --git a/app/daterange.py b/app/daterange.py
new file mode 100644
index 0000000..c878d32
--- /dev/null
+++ b/app/daterange.py
@@ -0,0 +1,36 @@
+"""Half-open date ranges ``[start, end)``.
+
+``end`` is exclusive: a reservation ``[2025-06-10, 2025-06-15)`` covers five days and the item
+is back on the morning of the 15th, so a range ending on a day and another starting on that
+same day do not overlap.
+"""
+
+from dataclasses import dataclass
+from datetime import date
+
+
+@dataclass(frozen=True)
+class DateRange:
+    start: date
+    end: date
+
+    def __post_init__(self) -> None:
+        if not self.start < self.end:
+            raise ValueError(f"empty date range: end {self.end} is not after start {self.start}")
+
+    @property
+    def days(self) -> int:
+        """Number of days in the range."""
+        return (self.end - self.start).days
+
+    def contains(self, day: date) -> bool:
+        """Whether ``day`` falls in ``[start, end)``."""
+        return self.start <= day < self.end
+
+    def overlaps(self, other: "DateRange") -> bool:
+        """Whether the two ranges share at least one day."""
+        return self.start < other.end and other.start < self.end
+
+    def overlap_days(self, other: "DateRange") -> int:
+        """Number of days the two ranges share (0 when they do not overlap)."""
+        return max(0, (min(self.end, other.end) - max(self.start, other.start)).days)

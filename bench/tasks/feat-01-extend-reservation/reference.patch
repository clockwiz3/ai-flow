+def extend_reservation(store: Store, reservation_id: int, data: ReservationExtend) -> Reservation:
+    """Move the end of an active reservation later.
+
+    The new end must be after the current one, the whole reservation must still respect
+    ``MAX_RENTAL_DAYS`` and the added days ``[current end, new end)`` must not collide with
+    another active reservation of the same item.
+    """
+    reservation = get_reservation(store, reservation_id)
+    if reservation.status is not ReservationStatus.ACTIVE:
+        raise ConflictError(
+            f"Reservation {reservation_id} is {reservation.status.value} and cannot be extended"
+        )
+    if data.end <= reservation.end:
+        raise InvalidRequestError("The new end must be after the current end")
+    if (data.end - reservation.start).days > MAX_RENTAL_DAYS:
+        raise InvalidRequestError(f"Reservations are limited to {MAX_RENTAL_DAYS} days")
+
+    conflicts = [
+        other
+        for other in store.reservations.for_item(reservation.item_id)
+        if other.id != reservation.id
+        and other.status is ReservationStatus.ACTIVE
+        and other.start < data.end
+        and reservation.end < other.end
+    ]
+    if conflicts:
+        ids = ", ".join(str(r.id) for r in conflicts)
+        raise ConflictError(
+            f"Item {reservation.item_id} is already reserved (reservations: {ids})"
+        )
+    return store.reservations.save(reservation.model_copy(update={"end": data.end}))

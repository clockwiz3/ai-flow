diff --git a/app/services/maintenance.py b/app/services/maintenance.py
new file mode 100644
index 0000000..02acd8e
--- /dev/null
+++ b/app/services/maintenance.py
@@ -0,0 +1,35 @@
+"""Scheduled maintenance windows: periods during which an item cannot be rented."""
+
+from app.errors import ConflictError
+from app.models import MaintenanceWindow, MaintenanceWindowCreate, ReservationStatus
+from app.services.availability import validate_range
+from app.services.catalog import get_item
+from app.storage import Store
+
+
+def list_windows(store: Store, item_id: int) -> list[MaintenanceWindow]:
+    """Maintenance windows of an item ordered by start date (then id)."""
+    get_item(store, item_id)
+    return sorted(store.maintenance.for_item(item_id), key=lambda w: (w.start, w.id))
+
+
+def schedule_window(
+    store: Store, item_id: int, data: MaintenanceWindowCreate
+) -> MaintenanceWindow:
+    """Schedule maintenance for ``[start, end)``; it may not overlap an active reservation."""
+    validate_range(data.start, data.end)
+    item = get_item(store, item_id)
+    clashes = [
+        r
+        for r in store.reservations.for_item(item.id)
+        if r.status is ReservationStatus.ACTIVE and r.start < data.end and data.start < r.end
+    ]
+    if clashes:
+        ids = ", ".join(str(r.id) for r in clashes)
+        raise ConflictError(
+            f"Maintenance overlaps active reservations of item {item.id} (reservations: {ids})"
+        )
+    window = MaintenanceWindow(
+        id=store.maintenance.allocate_id(), item_id=item.id, start=data.start, end=data.end
+    )
+    return store.maintenance.insert(window)

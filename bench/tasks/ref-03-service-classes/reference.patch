+class CatalogService:
+    """Categories and items of the shop."""
+
+    def __init__(self, store: Store) -> None:
+        self.store = store
+
+    def list_categories(self) -> list[Category]:
+        return self.store.categories.all()
+
+    def get_category(self, category_id: str) -> Category:
+        category = self.store.categories.get(category_id)
+        if category is None:
+            raise NotFoundError(f"Category {category_id!r} not found")
+        return category
+
+    def get_item(self, item_id: int) -> Item:
+        item = self.store.items.get(item_id)
+        if item is None:
+            raise NotFoundError(f"Item {item_id} not found")
+        return item
+
+    def list_items(
+        self,
+        *,
+        q: str | None = None,
+        category: str | None = None,
+        limit: int = DEFAULT_PAGE_SIZE,
+        offset: int = 0,
+    ) -> ItemPage:
+        """Search the catalog.
+
+        ``q`` filters by item name, ``category`` by category id. Results are ordered by item
+        id; ``offset`` items are skipped and at most ``limit`` returned. ``total`` is the
+        number of matching items before pagination.
+        """
+        if not 1 <= limit <= MAX_PAGE_SIZE:
+            raise InvalidRequestError(f"limit must be between 1 and {MAX_PAGE_SIZE}")
+        if offset < 0:
+            raise InvalidRequestError("offset must not be negative")
+
+        matching = [item for item in self.store.items.all() if _matches(item, q, category)]
+        return ItemPage(
+            items=matching[offset:limit],
+            total=len(matching),
+            limit=limit,
+            offset=offset,
+        )
+
+    def create_item(self, data: ItemCreate) -> Item:
+        """Add a new item to the catalog. The category must already exist."""
+        if data.category not in self.store.categories:
+            raise InvalidRequestError(f"Unknown category {data.category!r}")
+        return self.store.items.create(data)
+
+    def set_item_status(self, item_id: int, status: ItemStatus) -> Item:
+        """Move an item between available / maintenance / retired.
+
+        Retiring is permanent: a retired item cannot be brought back.
+        """
+        item = self.get_item(item_id)
+        if item.status is ItemStatus.RETIRED and status is not ItemStatus.RETIRED:
+            raise ConflictError(f"Item {item_id} is retired and cannot change status")
+        return self.store.items.save(item.model_copy(update={"status": status}))

@@ -0,0 +1,104 @@
+"""FastAPI dependency providers: the store, the clock and every service.
+
+Services are built per request from the providers they depend on, so overriding a provider
+with ``app.dependency_overrides`` (e.g. ``get_clock`` in a test) reaches every service that
+uses it.
+"""
+
+from typing import Annotated
+
+from fastapi import Depends, Request
+
+from app.clock import Clock
+from app.services.availability import AvailabilityService
+from app.services.catalog import CatalogService
+from app.services.customers import CustomerService
+from app.services.invoices import InvoiceService
+from app.services.pricing import PricingService
+from app.services.reports import ReportService
+from app.services.reservations import ReservationService
+from app.services.returns import ReturnService
+from app.storage import Store
+
+
+def get_store(request: Request) -> Store:
+    return request.app.state.store
+
+
+def get_clock(request: Request) -> Clock:
+    return request.app.state.clock
+
+
+StoreDep = Annotated[Store, Depends(get_store)]
+ClockDep = Annotated[Clock, Depends(get_clock)]
+
+
+def get_catalog_service(store: StoreDep) -> CatalogService:
+    return CatalogService(store)
+
+
+CatalogDep = Annotated[CatalogService, Depends(get_catalog_service)]
+
+
+def get_customer_service(store: StoreDep) -> CustomerService:
+    return CustomerService(store)
+
+
+CustomersDep = Annotated[CustomerService, Depends(get_customer_service)]
+
+
+def get_pricing_service(store: StoreDep) -> PricingService:
+    return PricingService(store)
+
+
+PricingDep = Annotated[PricingService, Depends(get_pricing_service)]
+
+
+def get_availability_service(store: StoreDep, catalog: CatalogDep) -> AvailabilityService:
+    return AvailabilityService(store, catalog)
+
+
+AvailabilityDep = Annotated[AvailabilityService, Depends(get_availability_service)]
+
+
+def get_reservation_service(
+    store: StoreDep,
+    clock: ClockDep,
+    catalog: CatalogDep,
+    customers: CustomersDep,
+    pricing: PricingDep,
+    availability: AvailabilityDep,
+) -> ReservationService:
+    return ReservationService(store, clock, catalog, customers, pricing, availability)
+
+
+ReservationsDep = Annotated[ReservationService, Depends(get_reservation_service)]
+
+
+def get_return_service(
+    store: StoreDep, clock: ClockDep, catalog: CatalogDep, reservations: ReservationsDep
+) -> ReturnService:
+    return ReturnService(store, clock, catalog, reservations)
+
+
+ReturnsDep = Annotated[ReturnService, Depends(get_return_service)]
+
+
+def get_invoice_service(
+    store: StoreDep,
+    catalog: CatalogDep,
+    customers: CustomersDep,
+    pricing: PricingDep,
+    reservations: ReservationsDep,
+) -> InvoiceService:
+    return InvoiceService(store, catalog, customers, pricing, reservations)
+
+
+InvoicesDep = Annotated[InvoiceService, Depends(get_invoice_service)]
+
+
+def get_report_service(store: StoreDep, invoices: InvoicesDep) -> ReportService:
+    return ReportService(store, invoices)
+
+
+ReportsDep = Annotated[ReportService, Depends(get_report_service)]

diff --git a/app/settings.py b/app/settings.py
new file mode 100644
index 0000000..89c61a3
--- /dev/null
+++ b/app/settings.py
@@ -0,0 +1,35 @@
+"""Business settings: every pricing and booking rule parameter in one place.
+
+Services read ``app.settings.PRICING`` at call time (``settings.PRICING.tax_rate``), never a
+copy taken at import time, so the active settings can be swapped by rebinding
+``app.settings.PRICING`` (e.g. ``dataclasses.replace(PRICING, tax_rate=...)``).
+"""
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from decimal import Decimal
+
+from app.models import CustomerTier
+
+
+def _default_tier_discounts() -> dict[CustomerTier, Decimal]:
+    return {
+        CustomerTier.REGULAR: Decimal("0"),
+        CustomerTier.SILVER: Decimal("0.05"),
+        CustomerTier.GOLD: Decimal("0.15"),
+    }
+
+
+@dataclass(frozen=True)
+class PricingSettings:
+    """Pricing and booking rule parameters. Rates are fractions (``0.20`` = 20%)."""
+
+    tax_rate: Decimal = Decimal("0.20")
+    tier_discounts: Mapping[CustomerTier, Decimal] = field(default_factory=_default_tier_discounts)
+    max_total_discount: Decimal = Decimal("0.30")
+    free_day_every: int = 7
+    late_fee_multiplier: Decimal = Decimal("1.5")
+    max_rental_days: int = 90
+
+
+PRICING = PricingSettings()
